extends SceneTree
const Rules = preload("res://scripts/case_rules.gd")

func _initialize() -> void:
	assert(Rules.found_count([false, false, false]) == 0)
	assert(Rules.found_count([true, false, true]) == 2)
	assert(Rules.found_count([true, true, true]) == 3)
	assert(not Rules.can_accuse([true, false, true]))
	assert(Rules.can_accuse([true, true, true]))
	assert(Rules.verdict([false, true, true], 1) == "incomplete")
	assert(Rules.verdict([true, true, true], 1) == "solved")
	assert(Rules.verdict([true, true, true], 0) == "incorrect")
	assert(Rules.verdict([true, true, true], 100) == "invalid")
	assert(Rules.next_hint([false, false, false]).contains("camera"), "camera hint first")
	assert(Rules.next_hint([true, false, false]).contains("cartao"), "second clue hint")
	assert(Rules.next_hint([true, true, false]).contains("porta"), "third clue hint")
	assert(Rules.next_hint([true, true, true]).contains("Todas"), "no spoiler when complete")
	assert(Rules.next_hint([]).contains("indisponivel"), "invalid evidence length rejected")
	assert(Rules.next_hint([1, false, false]).contains("invalido"), "non-boolean values rejected")
	assert(Rules.missing_count([false, true, false]) == 2, "two clues missing")
	assert(Rules.missing_count([true, true, true]) == 0, "complete evidence count")
	assert(Rules.missing_count([]) == 3, "invalid board is not complete")
	print("Detective rules: 18 assertions passed")
	quit()
